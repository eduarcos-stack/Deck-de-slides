# TRACE-LM backend — variáveis de ambiente (deploy Grau B).
# Copie para o painel do Fly.io/Render (segredos via `fly secrets set` ou
# dashboard). NUNCA versione valores reais.

# --- Sessão / assinatura de tokens (§48) ---
TRACELM_SECRET=troque-por-um-segredo-forte-aleatorio

# --- Ponte Supabase Auth (Grau B) ---
# Legacy JWT secret do projeto: Supabase → Project Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=cole-o-legacy-jwt-secret-do-supabase

# Mapeamento identidade → papel RBAC (opcional; padrão = viewer).
# E-mails separados por vírgula.
TRACELM_SUPABASE_ADMINS=eduarcos@gmail.com
TRACELM_SUPABASE_INVESTIGATORS=

# --- Demo público (dados sintéticos) ---
TRACELM_DEMO_SEED=1
TRACELM_DEMO_CASE=CASE-DEMO

# --- CORS: origem do frontend em produção (Vercel/Netlify) ---
# Sem esta variável, o backend libera "*" (apenas para uso local).
TRACELM_CORS_ORIGINS=https://tracelm.vercel.app

# --- Senhas do login clássico (seed) — troque antes de qualquer uso ---
TRACELM_ADMIN_PASSWORD=
TRACELM_INVESTIGATOR_PASSWORD=
TRACELM_VIEWER_PASSWORD=
