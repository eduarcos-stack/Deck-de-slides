# TRACE-LM frontend — variáveis de build (Vite). Definir no painel do
# Vercel/Netlify. As `VITE_*` são embutidas no bundle público, então use aqui
# APENAS a chave anônima (anon) do Supabase — nunca a service_role.

# URL do backend FastAPI em produção (Fly.io/Render). Sem barra final.
VITE_API_URL=https://tracelm-api.fly.dev

# Supabase Auth (Grau B). Project Settings → API.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-anon-public-key
